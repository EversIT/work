{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend",
  "projectType": "application",
  "tags": [],
  "targets": {
    "orval": {
      "command": "orval --config=apps/frontend/orval.config.ts",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [
        {
          "target": "openapi",
          "projects": "backend"
        }
      ],
      "inputs": [
        "{workspaceRoot}/apps/backend/openapi.json",
        "{projectRoot}/orval.config.ts",
        "{projectRoot}/src/api/fetcher.ts"
      ],
      "outputs": ["{projectRoot}/src/api/generated"],
      "cache": true
    },
    "build": {
      "defaultConfiguration": "production",
      "dependsOn": [
        {
          "target": "orval",
          "projects": "frontend"
        }
      ]
    },
    "container:local": {
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"],
      "options": {
        "engine": "docker",
        "file": "{workspaceRoot}/packages/docker/next.Dockerfile",
        "build-args": ["APP_NAME=frontend"],
        "metadata": {
          "images": ["work-frontend"],
          "load": "true",
          "tags": ["latest"]
        }
      }
    },
    "container": {
      "options": {
        "file": "{workspaceRoot}/packages/docker/next.Dockerfile",
        "cache-from": ["type=registry,ref=${EVERSIT_WORK_FRONTEND}:buildcache"],
        "cache-to": [
          "type=registry,ref=${EVERSIT_WORK_FRONTEND}:buildcache,mode=max"
        ],
        "metadata": {
          "images": ["${EVERSIT_WORK_FRONTEND}"],
          "tags": [
            "latest",
            "type=schedule",
            "type=ref,event=branch",
            "type=ref,event=tag",
            "type=ref,event=pr",
            "type=semver,pattern={{version}}",
            "type=semver,pattern={{major}}",
            "type=semver,pattern={{major}}.{{minor}}",
            "type=sha,prefix=sha-"
          ]
        },
        "engine": "docker",
        "build-args": ["APP_NAME=frontend"]
      },
      "executor": "@nx-tools/nx-container:build",
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": [
        {
          "target": "orval",
          "projects": "frontend"
        }
      ]
    },
    "test": {
      "dependsOn": [
        {
          "target": "orval",
          "projects": "frontend"
        }
      ]
    },
    "test-ci": {
      "dependsOn": [
        {
          "target": "orval",
          "projects": "frontend"
        }
      ]
    },
    "typecheck": {
      "dependsOn": [
        {
          "target": "orval",
          "projects": "frontend"
        }
      ]
    }
  }
}
