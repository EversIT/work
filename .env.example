# Copy to .env and fill in EVERY required value. There are intentionally no defaults for secrets;
# the backend and docker compose refuse to start without them.
# Generate hex secrets with:   openssl rand -hex 24      (hex keeps the DB URL free of special chars)
# JWT secret (>= 32 bytes):    openssl rand -base64 48
# Encryption key (32 bytes):   openssl rand -base64 32

# --- images -------------------------------------------------------------------------------------
# GHCR example: ghcr.io/<owner>/backend:latest   (or work-backend:latest after `nx run-many -t container:local`)
WORK_BACKEND_IMAGE=
WORK_FRONTEND_IMAGE=

# --- database -----------------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- required -----------------------------------------------------------------------------------
WORK_JWT_SECRET=
# Public URL users open in the browser. https:// in production.
WORK_FRONTEND_URL=

# --- optional -----------------------------------------------------------------------------------
# Close self-registration after creating your accounts.
WORK_REGISTRATION_ENABLED=true
# Sign-in/registration attempts per source address and minute.
# WORK_AUTH_RATE_LIMIT=10

# E-mail (password reset, invitations, notifications, automations). Leave WORK_SMTP_HOST empty to disable.
# WORK_SMTP_HOST=
# WORK_SMTP_PORT=587
# WORK_SMTP_USER=
# WORK_SMTP_PASS=
# WORK_SMTP_FROM=work <noreply@example.com>
# WORK_SMTP_TLS=starttls        # starttls | tls | none

# Slack integration. Needs WORK_ENCRYPTION_KEY, which encrypts the stored tokens.
# WORK_ENCRYPTION_KEY=
# WORK_SLACK_CLIENT_ID=
# WORK_SLACK_CLIENT_SECRET=

# Automations. Defaults are the safe ones: outgoing webhooks only to public https hosts,
# automation e-mail only to project members.
# WORK_WEBHOOK_ALLOW_PRIVATE=false
# WORK_WEBHOOK_ALLOW_HTTP=false
# WORK_ALLOW_EXTERNAL_EMAIL=false

# --- local development (Nx) ---------------------------------------------------------------------
# WORK_DATABASE_URL=postgres://<user>:<password>@localhost:5432/<db>
# BACKEND_URL=http://127.0.0.1:3001
