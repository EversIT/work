# Copy to .env and fill in EVERY required value. There are intentionally no defaults for secrets;
# the backend and docker compose refuse to start without them.
# Generate hex secrets with:   openssl rand -hex 24      (hex keeps the DB URL free of special chars)
# JWT secret (>= 32 bytes):    openssl rand -base64 48
# Encryption key (32 bytes):   openssl rand -base64 32

# --- images -------------------------------------------------------------------------------------
# Docker Hub: eversit/work-backend:<version> and eversit/work-frontend:<version> (pin a version, see the tags on Docker Hub;
# or work-backend:latest after `nx run-many -t container:local`)
WORK_BACKEND_IMAGE=
WORK_FRONTEND_IMAGE=

# --- database -----------------------------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- required -----------------------------------------------------------------------------------
WORK_JWT_SECRET=
# Public URL users open in the browser. https:// in production.
WORK_FRONTEND_URL=

# --- optional -----------------------------------------------------------------------------------
# Close self-registration after creating your accounts.
WORK_REGISTRATION_ENABLED=true
# Sign-in/registration attempts per source address and minute.
# WORK_AUTH_RATE_LIMIT=10
# Where rate-limit counters live: memory (per instance, default) or postgres (shared by all instances).
# WORK_RATE_LIMIT_BACKEND=memory
# New accounts must confirm their e-mail address first (needs SMTP). Unset = on whenever SMTP is set.
# WORK_REQUIRE_EMAIL_VERIFICATION=

# E-mail (password reset, invitations, notifications, automations). Leave WORK_SMTP_HOST empty to disable.
# WORK_SMTP_HOST=
# WORK_SMTP_PORT=587
# WORK_SMTP_USER=
# WORK_SMTP_PASS=
# WORK_SMTP_FROM=work <noreply@example.com>
# WORK_SMTP_TLS=starttls        # starttls | tls | none

# WORK_ENCRYPTION_KEY encrypts stored tokens and the secrets of two-factor authentication; without it
# neither Slack nor MFA is available. Slack additionally needs its client id and secret.
# WORK_ENCRYPTION_KEY=
# WORK_SLACK_CLIENT_ID=
# WORK_SLACK_CLIENT_SECRET=

# File storage: local (default, the uploads volume), s3 or azure. The bucket/container must be private
# and must exist; files are only served through the API. Without keys the environment's identity is used.
# WORK_STORAGE=local
# WORK_S3_BUCKET=
# WORK_S3_REGION=us-east-1
# WORK_S3_ENDPOINT=               # only for S3-compatible services (MinIO, R2, ...)
# WORK_S3_ACCESS_KEY_ID=
# WORK_S3_SECRET_ACCESS_KEY=
# WORK_AZURE_ACCOUNT=
# WORK_AZURE_CONTAINER=
# WORK_AZURE_ACCESS_KEY=

# Single sign-on (all optional). Redirect URI to register at the provider:
#   <WORK_FRONTEND_URL>/api/v1/auth/sso/<google|github|microsoft|slack>/callback
# WORK_SSO_GOOGLE_CLIENT_ID=
# WORK_SSO_GOOGLE_CLIENT_SECRET=
# WORK_SSO_GITHUB_CLIENT_ID=
# WORK_SSO_GITHUB_CLIENT_SECRET=
# WORK_SSO_MICROSOFT_CLIENT_ID=
# WORK_SSO_MICROSOFT_CLIENT_SECRET=
# WORK_SSO_MICROSOFT_TENANT=      # your tenant id or domain; common/organizations/consumers are refused
# WORK_SSO_SLACK_CLIENT_ID=       # "Sign in with Slack" app, separate from the notification app
# WORK_SSO_SLACK_CLIENT_SECRET=
# SAML 2.0: path (inside the container) to the IdP's metadata XML. The IdP must sign the assertion.
# ACS URL: <WORK_FRONTEND_URL>/api/v1/auth/saml/acs   SP metadata: <WORK_FRONTEND_URL>/api/v1/auth/saml/metadata
# WORK_SAML_IDP_METADATA_FILE=
# WORK_SAML_ENTITY_ID=            # default: the SP metadata URL
# WORK_SAML_SP_KEY_FILE=          # optional PKCS#8 PEM: sign authentication requests

# Automations. Defaults are the safe ones: outgoing webhooks only to public https hosts,
# automation e-mail only to project members.
# WORK_WEBHOOK_ALLOW_PRIVATE=false
# WORK_WEBHOOK_ALLOW_HTTP=false
# WORK_ALLOW_EXTERNAL_EMAIL=false

# AI assistant. All AI features are off until a self-hosted language model is set: either here, or
# by an admin in the app (Administration -> AI), which wins over these variables. The model runs on
# your own machine (any server with the OpenAI chat protocol, e.g. llama.cpp or Ollama). To use the
# bundled one, put a .gguf file into WORK_AI_MODEL_DIR and start compose with `--profile ai`. There is no cloud service and no API key.
# WORK_AI_MODEL_URL=http://model:8081
# WORK_AI_MODEL_DIR=./models
# WORK_AI_MODEL_FILE=work-assistant.gguf
# WORK_AI_MODEL_NAME=work-assistant
# WORK_AI_MAX_OUTPUT_TOKENS=1024

# --- local development (Nx) ---------------------------------------------------------------------
# WORK_DATABASE_URL=postgres://<user>:<password>@localhost:5432/<db>
# BACKEND_URL=http://127.0.0.1:3001
